#include <iostream>
using namespace std;
int main() {
    int arr[] = {10, 20, 10, 30, 20, 40, 30};
    int n = 7;
    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            if (arr[i] == arr[j]) {
                for (int k = j; k < n - 1; k++) {
                    arr[k] = arr[k + 1];
                }
                n--;    // Reduce array size
                j--;    // Check the new element at position j
            }
        }
    }
    cout << "Array after removing duplicates: ";
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }
    return 0;
}
