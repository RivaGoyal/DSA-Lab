#include <iostream>
using namespace std;
int main()
{
    int n, k;
    cout << "Enter size of array: ";
    cin >> n;
    int arr[n];
    cout << "Enter array elements: ";
    for (int i = 0; i < n; i++)
        cin >> arr[i];
    cout << "Enter value of k: ";
    cin >> k;
    k = k % n;  
    for (int r = 0; r < k; r++)
    {
        int first = arr[0];
        for (int i = 0; i < n - 1; i++)
        {
            arr[i] = arr[i + 1];
        }
        arr[n - 1] = first;
    }
    cout << "Array after rotation: ";
    for (int i = 0; i < n; i++)
        cout << arr[i] << " ";
    return 0;
}
